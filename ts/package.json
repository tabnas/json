{
  "name": "@tabnas/json",
  "version": "0.5.2",
  "main": "dist/json.js",
  "type": "commonjs",
  "types": "dist/json.d.ts",
  "description": "A standard JSON parser (RFC 8259).",
  "homepage": "https://github.com/tabnas/json",
  "keywords": [
    "json",
    "parser",
    "rfc8259",
    "ecma-404"
  ],
  "author": "tabnas",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build src",
    "watch": "tsc --build src -w",
    "install-json-test-suite": "sh ../test/fetch-jsontestsuite.sh",
    "clean": "rm -rf node_modules dist package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "pretest": "npm run install-json-test-suite",
    "test": "npm run build && node --enable-source-maps --test test/**/*.test.js",
    "precoverage": "npm run install-json-test-suite",
    "coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include=dist/json.js --test-coverage-include=dist/json-cli.js --test-coverage-lines=0.95 test/**/*.test.js",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"` && echo TAG: ts/v$REPO_VERSION && git commit -a -m v$REPO_VERSION && git push && git tag ts/v$REPO_VERSION && git push origin ts/v$REPO_VERSION;",
    "repo-publish": "npm run clean && npm i && npm run repo-publish-quick",
    "repo-publish-quick": "npm run build && npm run test && npm run repo-tag",
    "repo-stage": "npm run clean && npm i && npm run repo-stage-quick",
    "repo-stage-quick": "npm run build && npm run test && npm stage publish",
    "repo-stage-list": "npm stage list",
    "repo-stage-approve": "npm stage approve"
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "bin": {
    "tabnas-json": "bin/json"
  },
  "exports": {
    ".": "./dist/json.js"
  },
  "devDependencies": {
    "@tabnas/debug": "*",
    "@tabnas/parser": "*",
    "@tabnas/railroad": "*",
    "@tabnas/support": "*",
    "@types/node": "20.x",
    "typescript": "5.x"
  },
  "peerDependencies": {
    "@tabnas/parser": ">=0"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tabnas/json.git",
    "directory": "ts"
  }
}
